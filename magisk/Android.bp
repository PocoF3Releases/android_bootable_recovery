package {
    default_applicable_licenses: ["recovery_bundled_magisk_license"],
}

license {
    name: "recovery_bundled_magisk_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-GPL-3.0-only"],
    license_text: ["LICENSE"],
}

prebuilt_etc {
    name: "recovery_bundled_magisk",
    recovery: true,
    src: "Magisk-v31.0.apk",
    filename: "magisk.apk",
    sub_dir: "recovery",
}

prebuilt_etc {
    name: "recovery_bundled_magisk_script",
    recovery: true,
    src: "install-magisk.sh",
    filename: "install-magisk.sh",
    sub_dir: "recovery",
}
